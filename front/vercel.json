{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "http://ecohouse-env.eba-vay8q3u6.us-east-1.elasticbeanstalk.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://ecohouse-env.eba-vay8q3u6.us-east-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}